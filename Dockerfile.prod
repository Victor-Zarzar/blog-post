# ============================================
# Stage 1: Dependencies Installation Stage
# ============================================

FROM oven/bun:1 AS deps

WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# =========================
# Stage 2 - builder
# =========================

FROM oven/bun:1 AS builder

WORKDIR /app

ARG DATABASE_URL
ARG POSTGRES_USER
ARG POSTGRES_PASSWORD
ARG POSTGRES_DB
ARG BETTER_AUTH_SECRET
ARG BETTER_AUTH_URL
ARG SMTP_EMAIL
ARG SMTP_PASSWORD
ARG SMTP_HOST
ARG SMTP_PORT
ARG SMTP_FROM
ARG GITHUB_CLIENT_ID
ARG GITHUB_CLIENT_SECRET
ARG REDIS_URL
ARG GOOGLE_RECAPTCHA_SECRET_KEY
ARG NEXT_PUBLIC_WEBSITE_URL
ARG NEXT_PUBLIC_DISABLE_DEVTOOLS
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_GOOGLE_RECAPTCHA_PUBLIC_KEY

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

ENV DATABASE_URL=$DATABASE_URL
ENV POSTGRES_USER=$POSTGRES_USER
ENV POSTGRES_PASSWORD=$POSTGRES_PASSWORD
ENV POSTGRES_DB=$POSTGRES_DB
ENV BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
ENV BETTER_AUTH_URL=$BETTER_AUTH_URL
ENV SMTP_EMAIL=$SMTP_EMAIL
ENV SMTP_PASSWORD=$SMTP_PASSWORD
ENV SMTP_HOST=$SMTP_HOST
ENV SMTP_PORT=$SMTP_PORT
ENV SMTP_FROM=$SMTP_FROM
ENV GITHUB_CLIENT_ID=$GITHUB_CLIENT_ID
ENV GITHUB_CLIENT_SECRET=$GITHUB_CLIENT_SECRET
ENV REDIS_URL=$REDIS_URL
ENV GOOGLE_RECAPTCHA_SECRET_KEY=$GOOGLE_RECAPTCHA_SECRET_KEY
ENV NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL
ENV NEXT_PUBLIC_DISABLE_DEVTOOLS=$NEXT_PUBLIC_DISABLE_DEVTOOLS
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_GOOGLE_RECAPTCHA_PUBLIC_KEY=$NEXT_PUBLIC_GOOGLE_RECAPTCHA_PUBLIC_KEY

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN bun run build

# =========================
# Stage 3 - runner
# =========================

FROM oven/bun:1 AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["bun", "server.js"]
